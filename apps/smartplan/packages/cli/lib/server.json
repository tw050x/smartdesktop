    {
      "name": "create_board",
      "description": "Makes a new board and shows it to the user. Ask what it's for first. With no lists, it gets To do, Doing and Done. Gives the ids of its lists and cards.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "What the user will know it by, such as \"Website relaunch\""
          },
          "description": {
            "description": "What it's for, in a sentence or two",
            "type": "string",
            "maxLength": 2000
          },
          "lists": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Such as \"To do\", \"Doing\", \"Done\", or a stage of the work"
                },
                "cards": {
                  "description": "The cards it starts with, in order",
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300,
                        "description": "What the work is, in a few words"
                      },
                      "description": {
                        "description": "The details, in Markdown (GitHub-flavoured: lists, tables, code)",
                        "type": "string",
                        "maxLength": 50000
                      },
                      "labels": {
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40,
                              "description": "A word or two, such as \"Bug\" or \"Design\""
                            },
                            "color": {
                              "description": "Its colour (default grey). Use the same colour for the same label across the board",
                              "type": "string",
                              "enum": [
                                "green",
                                "yellow",
                                "orange",
                                "red",
                                "purple",
                                "blue",
                                "grey"
                              ]
                            }
                          },
                          "required": [
                            "name"
                          ]
                        }
                      },
                      "due": {
                        "description": "When it's due, YYYY-MM-DD (null for none)",
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "checklist": {
                        "description": "Steps to tick off. Send the whole list: it replaces the one there",
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 300
                            },
                            "done": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "text"
                          ]
                        }
                      }
                    },
                    "required": [
                      "title"
                    ]
                  }
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "icon": {
            "description": "Its icon, shown on its tab and on home (see set_icon for the list)",
            "type": "string",
            "enum": [
              "file-text",
              "contact",
              "briefcase",
              "graduation-cap",
