{
  "name": "@smartdesktop/app",
  "productName": "SmartDesktop",
  "version": "0.1.2",
  "description": "The AI chat for SmartDoc and SmartSpec, run with your own AI.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.tw050x.smartdesktop",
    "productName": "SmartDesktop",
    "directories": {
      "output": "../../dist",
      "buildResources": "resources"
    },
    "files": [
      "src/main/**/*",
      "build/renderer/**/*",
      "resources/tray*.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "tw050x",
        "repo": "smartdesktop"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "artifactName": "SmartDesktop-mac-${arch}.${ext}"
    },
    "artifactName": "smartdesktop-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
